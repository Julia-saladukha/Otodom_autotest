<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="false"
      internalLogLevel="Warn"
      internalLogFile="internal-nlog.log">
  <variable name="logDir" value="${basedir}/Logs" />

  <targets>
    <target xsi:type="File" name="logfile" fileName="${logDir}/test-${shortdate}.log"
            layout="${longdate}|${level:uppercase=true}|${logger}|${message}${onexception:inner=${newline}${exception:format=ToString}}" />
    <target xsi:type="Console" name="console" layout="${time}|${level:uppercase=true}|${logger}|${message}" />
  </targets>

  <rules>
    <logger name="*" minlevel="Info" writeTo="logfile,console" />
    <logger name="Autotests_task1.Hooks.ReqnrollHooks" minlevel="Debug" writeTo="logfile,console" />
  </rules>
</nlog>
